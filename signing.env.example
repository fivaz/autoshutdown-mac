# Copy to signing.env and fill in. signing.env is gitignored.
#
# Find the exact strings with:
#   security find-identity -v -p codesigning     # Developer ID Application
#   security find-identity -v                    # Developer ID Installer
#
# Leave a value empty to let make-pkg.sh pick the first matching identity itself.

DEVELOPER_ID_APP="Developer ID Application: Your Name (TEAMID)"
DEVELOPER_ID_INSTALLER="Developer ID Installer: Your Name (TEAMID)"

# Notarisation credentials, stored once with:
#   xcrun notarytool store-credentials autoshutdown-notary \
#       --apple-id you@example.com --team-id TEAMID --password APP-SPECIFIC-PASSWORD
NOTARY_PROFILE="autoshutdown-notary"
